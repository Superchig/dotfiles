#!/bin/sh

if ! command -v kdotool > /dev/null 2>&1; then
  notify-send "open-or-switch-to-kitty require kdotool"
  exit 1
fi

KITTY_WINDOW_ID="$(kdotool search --classname kitty)"
ACTIVE_WINDOW_ID="$(kdotool getactivewindow)"

if ! [ -n "$KITTY_WINDOW_ID" ]; then
  kitty &> /dev/null &
  return
fi

if ! [ "$KITTY_WINDOW_ID" = "$ACTIVE_WINDOW_ID" ]; then
  kdotool windowactivate "$KITTY_WINDOW_ID"
fi
